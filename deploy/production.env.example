# Public, non-secret production settings. Replace example hostnames before deployment.
POSTGRES_DB=ncct_training
POSTGRES_USER=ncct
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
DATABASE_URL_FILE=./deploy/secrets/database_url
JWT_SECRET_KEY_FILE=./deploy/secrets/jwt_secret_key
BIOMETRIC_ENCRYPTION_KEY_FILE=./deploy/secrets/biometric_encryption_key

BACKEND_CORS_ORIGINS=https://training.example.gov.in
ALLOWED_HOSTS=training.example.gov.in,localhost,127.0.0.1
FRONTEND_PUBLIC_URL=https://training.example.gov.in
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

CAREER_AI_PROVIDER=local
BIOMETRIC_ENABLED=false
FACE_VERIFICATION_PROVIDER=demo

# Add docker-compose.gemini.yml and set this host path only when using Gemini.
GEMINI_API_KEY_FILE=./deploy/secrets/gemini_api_key
